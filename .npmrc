engine-strict=true
fund=false
# Dependency install scripts (preinstall, install, postinstall) are one of the main vectors for malicious code.
# They only run when approved in package.json "allowScripts"; unreviewed ones fail the install.
# Maintain the list with `npm install-scripts approve --no-allow-scripts-pin|deny|ls|prune`.
# Keys are name-only on purpose: version-pinned keys break every Dependabot PR that bumps one of these packages,
# because Dependabot never updates "allowScripts". New versions are still held back by min-release-age below.
strict-allow-scripts=true
# Only install versions published at least 14 days ago; most malicious releases are found and unpublished within that window.
# Must stay < Dependabot cooldown in .github/dependabot.yml, otherwise Dependabot PRs fail to resolve
# (npm counts exact 24h periods while Dependabot runs at a fixed time, so equal values can miss by hours).
# Urgent fix younger than 14 days: add the package to min-release-age-exclude temporarily.
min-release-age=14
